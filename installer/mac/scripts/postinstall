#!/bin/bash
# AU-Cache auffrischen, damit Logic / GarageBand UBTune sofort sehen
killall -9 AudioComponentRegistrar 2>/dev/null || true
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/Components/UBTune.component" 2>/dev/null || true
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/VST3/UBTune.vst3" 2>/dev/null || true
xattr -dr com.apple.quarantine "/Applications/UBTune.app" 2>/dev/null || true
exit 0
